---
import Button from "@components/Button.astro";
import ThemeToggle from "@components/ThemeToggle.astro";
import { SITE, LINKS } from "@consts";
const { pathname } = Astro.url;
const subpath = pathname.match(/[^/]+/g);
---

<div
  id="drawer"
  class="drawer"
  role="dialog"
  aria-modal="true"
  aria-label="Mobile navigation"
  aria-hidden="true"
  inert
>
  <nav aria-label="Primary">
    {
      LINKS.map((LINK) => (
        <Button
          href={LINK.HREF}
          aria-current={pathname === LINK.HREF || "/" + subpath?.[0] === LINK.HREF ? "page" : undefined}
        >
          {LINK.TEXT}
        </Button>
      ))
    }
  </nav>
  <div>
    <Button
      href="/search"
      iconOnly
      aria-label={`Search blog posts and projects on ${SITE.NAME}`}
    >
      <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor">
        <use href="/ui.svg#search"></use>
      </svg>
    </Button>
    <Button
      href="/rss.xml"
      external
      iconOnly
      aria-label={`RSS feed for ${SITE.NAME}`}
    >
      <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor">
        <use href="/ui.svg#rss"></use>
      </svg>
    </Button>
    <ThemeToggle
      id="drawer-theme-button"
      size="lg"
    />
  </div>
</div>

<style>
  .drawer {
    display: none;
    padding: 1rem 0;
    border-top: 1px solid currentColor;
  }

  .drawer.open {
    display: block;
  }
</style>
