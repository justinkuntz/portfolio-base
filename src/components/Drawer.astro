---
import Button from "@components/Button.astro";
import ThemeToggle from "@components/ThemeToggle.astro";
import { SITE, LINKS } from "@consts";
const { pathname } = Astro.url;
const subpath = pathname.match(/[^/]+/g);
---

<div
  id="drawer"
  class="drawer"
  role="dialog"
  aria-modal="true"
  aria-label="Mobile navigation"
  aria-hidden="true"
  inert
>
  <nav class="drawer__nav" aria-label="Primary">
    {
      LINKS.map((LINK) => (
        <Button
          href={LINK.HREF}
          variant={pathname === LINK.HREF || "/" + subpath?.[0] === LINK.HREF ? "primary" : "ghost"}
          size="lg"
          aria-current={pathname === LINK.HREF || "/" + subpath?.[0] === LINK.HREF ? "page" : undefined}
          class="drawer__nav-link"
        >
          {LINK.TEXT}
        </Button>
      ))
    }
  </nav>
  <div class="drawer__actions">
    <Button
      href="/search"
      variant={pathname === "/search" || "/" + subpath?.[0] === "search" ? "primary" : "ghost"}
      size="md"
      iconOnly
      aria-label={`Search blog posts and projects on ${SITE.NAME}`}
      class="drawer__action-btn"
    >
      <svg class="drawer__action-icon" aria-hidden="true">
        <use href="/ui.svg#search"></use>
      </svg>
    </Button>
    <Button
      href="/rss.xml"
      external
      variant="ghost"
      size="md"
      iconOnly
      aria-label={`RSS feed for ${SITE.NAME}`}
      class="drawer__action-btn"
    >
      <svg class="drawer__action-icon" aria-hidden="true">
        <use href="/ui.svg#rss"></use>
      </svg>
    </Button>
    <ThemeToggle
      id="drawer-theme-button"
      size="lg"
      class="drawer__theme-toggle"
    />
  </div>
</div>

<style>
  .drawer {
    display: none;
    flex-direction: column;
    gap: 1rem;
    padding: 1rem 0;
    overflow: auto;
    border-top: 1px solid currentColor;
  }

  @media (min-width: 768px) {
    .drawer {
      display: none;
    }
  }

  .drawer.open {
    display: flex;
  }

  .drawer__nav {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
  }

  /* :global() so styles apply to Button's rendered root */
  .drawer :global(.drawer__nav-link) {
    width: 100%;
    justify-content: flex-start;
  }

  .drawer__actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .drawer :global(.drawer__action-btn) {
    min-width: 2.25rem;
  }

  .drawer :global(.drawer__action-icon) {
    width: 1rem;
    height: 1rem;
    stroke: currentColor;
    fill: none;
  }
</style>
