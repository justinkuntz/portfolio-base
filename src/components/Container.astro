---
import { cn } from "@lib/utils";

type Props = {
  size: "sm" | "md" | "lg" | "xl" | "2xl";
};

const { size } = Astro.props;
---

<div
  class={cn("container", size === "sm" && "container--sm", size === "md" && "container--md", size === "lg" && "container--lg", size === "xl" && "container--xl", size === "2xl" && "container--2xl")}
>
  <slot />
</div>

<style>
  .container {
    box-sizing: border-box;
    width: 100%;
    max-width: 100%;
    height: 100%;
    margin-inline: auto;
    padding-inline: 1rem;
  }

  .container--sm {
    max-width: 40rem;
  }

  .container--md {
    max-width: 48rem;
  }

  .container--lg {
    max-width: 64rem;
  }

  .container--xl {
    max-width: 72rem;
  }

  .container--2xl {
    max-width: 80rem;
  }
</style>
