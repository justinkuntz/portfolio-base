---
type Props = {
  size: "sm" | "md" | "lg" | "xl" | "2xl";
};

const { size } = Astro.props;
const maxWidth = {
  sm: "40rem",
  md: "48rem",
  lg: "64rem",
  xl: "72rem",
  "2xl": "80rem",
}[size];
---

<div
  style={`box-sizing:border-box;width:100%;max-width:${maxWidth};height:100%;margin-inline:auto;padding-inline:1rem;`}
>
  <slot />
</div>
