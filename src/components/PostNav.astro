---
import Link from "@components/Link.astro";

type NavEntry = {
  collection: string;
  id: string;
  data: {
    title: string;
  };
};

type Props = {
  prev: NavEntry;
  next: NavEntry;
  topSpacing?: "md" | "lg";
};

const { prev, next, topSpacing = "lg" } = Astro.props;
const marginTop = topSpacing === "md" ? "2rem" : "3rem";
---

<nav aria-label="Pagination" style={`margin-top:${marginTop};`}>
  <p>
    Previous:
    {" "}
    <Link href={`/${prev.collection}/${prev.id}`}>{prev.data.title}</Link>
  </p>
  <p>
    Next:
    {" "}
    <Link href={`/${next.collection}/${next.id}`}>{next.data.title}</Link>
  </p>
</nav>
