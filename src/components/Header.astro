---
import Container from "@components/Container.astro";
import Button from "@components/Button.astro";
import ThemeToggle from "@components/ThemeToggle.astro";
const { pathname } = Astro.url;
const subpath = pathname.match(/[^/]+/g);
import { SITE, LINKS } from "@consts";
---

<header id="header" class="header">
  <Container size="xl">
    <div class="header-bar">
      <a href="/" class="brand-link">
          <svg width="24" height="24" aria-hidden="true">
            <use href="/brand.svg#brand"></use>
          </svg>
          <span>{SITE.NAME}</span>
      </a>
      <nav class="desktop-nav" aria-label="Primary">
          {
            LINKS.map((LINK) => (
              <Button
                href={LINK.HREF}
                variant={pathname === LINK.HREF || "/" + subpath?.[0] === LINK.HREF ? "primary" : "ghost"}
                size="lg"
                aria-current={pathname === LINK.HREF || "/" + subpath?.[0] === LINK.HREF ? "page" : undefined}
              >
                {LINK.TEXT}
              </Button>
            ))
          }
      </nav>
      <div class="header-actions">
          <Button
            href="/search"
            variant={pathname === "/search" || "/" + subpath?.[0] === "search" ? "primary" : "ghost"}
            size="md"
            iconOnly
            aria-label={`Search blog posts and projects on ${SITE.NAME}`}
            class="desktop-only"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor">
              <use href="/ui.svg#search"></use>
            </svg>
          </Button>
          <span class="desktop-only">
            <ThemeToggle
              id="header-theme-button"
              size="md"
            />
          </span>
          <Button
            id="header-drawer-button"
            type="button"
            variant="ghost"
            size="md"
            iconOnly
            aria-controls="drawer"
            aria-expanded="false"
            aria-label="Open navigation menu"
            class="mobile-only"
          >
            <svg id="drawer-open" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor">
              <use href="/ui.svg#menu"></use>
            </svg>
            <svg id="drawer-close" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" style="display:none;">
              <use href="/ui.svg#x"></use>
            </svg>
          </Button>
      </div>
    </div>
  </Container>
</header>

<style>
  .header {
    border-bottom: 1px solid currentColor;
  }

  .header-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    padding: 1rem 0;
  }

  .brand-link {
    color: currentColor;
    text-decoration: none;
  }

  .brand-link svg {
    fill: currentColor;
    vertical-align: middle;
  }

  .desktop-nav {
    display: none;
  }

  @media (min-width: 768px) {
    .desktop-nav {
      display: block;
    }
  }

  .header-actions {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }

  .desktop-only {
    display: none;
  }

  @media (min-width: 768px) {
    .desktop-only {
      display: inline;
    }
  }

  @media (min-width: 768px) {
    .mobile-only {
      display: none;
    }
  }
</style>

<script is:inline>
  function setDrawerState(isOpen, options = { restoreFocus: true }) {
    const drawer = document.getElementById("drawer");
    const drawerButton = document.getElementById("header-drawer-button");
    const openIcon = document.getElementById("drawer-open");
    const closeIcon = document.getElementById("drawer-close");

    if (!drawer || !drawerButton) return;

    drawer.classList.toggle("open", isOpen);
    drawerButton.classList.toggle("open", isOpen);
    drawerButton.setAttribute("aria-expanded", String(isOpen));
    drawerButton.setAttribute(
      "aria-label",
      isOpen ? "Close navigation menu" : "Open navigation menu",
    );
    drawer.setAttribute("aria-hidden", String(!isOpen));
    if (openIcon instanceof HTMLElement) openIcon.style.display = isOpen ? "none" : "";
    if (closeIcon instanceof HTMLElement) closeIcon.style.display = isOpen ? "" : "none";

    if (isOpen) {
      drawer.removeAttribute("inert");
      const firstLink = drawer.querySelector('a, button:not([disabled])');
      if (firstLink instanceof HTMLElement) firstLink.focus();
    } else if (options.restoreFocus) {
      drawer.setAttribute("inert", "");
      drawerButton.focus();
    } else {
      drawer.setAttribute("inert", "");
    }
  }

  function toggleDrawer() {
    const drawer = document.getElementById("drawer");
    if (!drawer) return;
    setDrawerState(!drawer.classList.contains("open"));
  }

  function initializeDrawerButton() {
    const drawerButton = document.getElementById("header-drawer-button");
    const drawer = document.getElementById("drawer");

    if (!drawerButton || !drawer) return;

    drawerButton.onclick = () => toggleDrawer();

    drawer.onclick = (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      if (target.closest('a[href]')) {
        setDrawerState(false);
      }
    };

    if (!window.__drawerEscapeHandlerBound) {
      document.addEventListener("keydown", (event) => {
        const activeDrawer = document.getElementById("drawer");
        if (event.key === "Escape" && activeDrawer?.classList.contains("open")) {
          setDrawerState(false);
        }
      });
      window.__drawerEscapeHandlerBound = true;
    }

    setDrawerState(false, { restoreFocus: false });
  }

  window.__drawerEscapeHandlerBound = window.__drawerEscapeHandlerBound ?? false;
  window.__drawerAfterSwapHandlerBound = window.__drawerAfterSwapHandlerBound ?? false;
</script>
<script is:inline>
  function bootDrawerButton() {
    if (document.getElementById("header-drawer-button") && document.getElementById("drawer")) {
      initializeDrawerButton();
    }
  }

  if (!window.__drawerAfterSwapHandlerBound) {
    document.addEventListener("astro:after-swap", bootDrawerButton);
    window.__drawerAfterSwapHandlerBound = true;
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", bootDrawerButton, { once: true });
  } else {
    bootDrawerButton();
  }
</script>
