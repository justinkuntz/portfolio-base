---
/* Renders <a> when href is set, otherwise <button>. */
type Props = {
  href?: string;
  iconLeft?: "arrow" | "arrow-left";
  iconRight?: "arrow" | "arrow-left";
  iconOnly?: boolean;
  external?: boolean;
  class?: string;
  type?: "button" | "submit" | "reset";
  [key: string]: unknown;
};

const {
  href,
  iconLeft,
  iconRight,
  iconOnly = false,
  external = false,
  class: className,
  type,
  ...rest
} = Astro.props;

const isLink = !!href;
const hasContent = Astro.slots.has("default");
const showText = hasContent && !iconOnly;
const showSlotAsIcon = iconOnly && hasContent;
---

{
  isLink ? (
    <a
      href={href}
      target={external ? "_blank" : undefined}
      rel={external ? "noopener noreferrer" : undefined}
      class={className}
      {...rest}
    >
      {iconLeft && (
        <svg
          viewBox="0 0 24 24"
          width="16"
          height="16"
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="5" y1="12" x2="19" y2="12" />
          <polyline
            points={
              iconLeft === "arrow-left" ? "12 5 5 12 12 19" : "12 5 19 12 12 19"
            }
          />
        </svg>
      )}
      {showText ? (
        <span>
          <slot />
        </span>
      ) : showSlotAsIcon ? (
        <span>
          <slot />
        </span>
      ) : null}
      {iconRight && (
        <svg
          viewBox="0 0 24 24"
          width="16"
          height="16"
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="5" y1="12" x2="19" y2="12" />
          <polyline
            points={
              iconRight === "arrow-left"
                ? "12 5 5 12 12 19"
                : "12 5 19 12 12 19"
            }
          />
        </svg>
      )}
    </a>
  ) : (
    <button
      type={type === "submit" || type === "reset" ? type : "button"}
      class={className}
      {...rest}
    >
      {iconLeft && (
        <svg
          viewBox="0 0 24 24"
          width="16"
          height="16"
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="5" y1="12" x2="19" y2="12" />
          <polyline
            points={
              iconLeft === "arrow-left" ? "12 5 5 12 12 19" : "12 5 19 12 12 19"
            }
          />
        </svg>
      )}
      {showText ? (
        <span>
          <slot />
        </span>
      ) : showSlotAsIcon ? (
        <span>
          <slot />
        </span>
      ) : null}
      {iconRight && (
        <svg
          viewBox="0 0 24 24"
          width="16"
          height="16"
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="5" y1="12" x2="19" y2="12" />
          <polyline
            points={
              iconRight === "arrow-left"
                ? "12 5 5 12 12 19"
                : "12 5 19 12 12 19"
            }
          />
        </svg>
      )}
    </button>
  )
}
