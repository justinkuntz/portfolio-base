---
/**
 * Button component: primary, secondary, ghost, outline, icon-only.
 * Renders <a> when href is set, otherwise <button>.
 */
type Props = {
  variant?: "primary" | "secondary" | "ghost" | "outline";
  size?: "sm" | "md" | "lg";
  href?: string;
  iconLeft?: "arrow" | "arrow-left";
  iconRight?: "arrow" | "arrow-left";
  iconOnly?: boolean;
  external?: boolean;
  class?: string;
  type?: "button" | "submit" | "reset";
  [key: string]: unknown;
};

const {
  variant = "primary",
  size = "md",
  href,
  iconLeft,
  iconRight,
  iconOnly = false,
  external = false,
  class: className,
  type,
  ...rest
} = Astro.props;

const isLink = !!href;
const hasContent = Astro.slots.has("default");
const showText = hasContent && !iconOnly;
const showSlotAsIcon = iconOnly && hasContent;
---

{
  isLink ? (
    <a
      href={href}
      target={external ? "_blank" : undefined}
      rel={external ? "noopener noreferrer" : undefined}
      class:list={[
        "btn",
        `btn--${variant}`,
        `btn--${size}`,
        iconOnly && "btn--icon-only",
        className,
      ]}
      {...rest}
    >
      {iconLeft && (
        <svg
          class="btn__icon arrow-animated btn__icon--left"
          class:list={[iconLeft === "arrow-left" && "arrow-animated--left"]}
          viewBox="0 0 24 24"
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="5" y1="12" x2="19" y2="12" class="arrow-animated__line" />
          <polyline
            points={
              iconLeft === "arrow-left" ? "12 5 5 12 12 19" : "12 5 19 12 12 19"
            }
            class="arrow-animated__poly"
          />
        </svg>
      )}
      {showText ? (
        <span class="btn__content">
          <slot />
        </span>
      ) : showSlotAsIcon ? (
        <span class="btn__content">
          <slot />
        </span>
      ) : null}
      {iconRight && (
        <svg
          class="btn__icon arrow-animated btn__icon--right"
          class:list={[iconRight === "arrow-left" && "arrow-animated--left"]}
          viewBox="0 0 24 24"
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="5" y1="12" x2="19" y2="12" class="arrow-animated__line" />
          <polyline
            points={
              iconRight === "arrow-left"
                ? "12 5 5 12 12 19"
                : "12 5 19 12 12 19"
            }
            class="arrow-animated__poly"
          />
        </svg>
      )}
    </a>
  ) : (
    <button
      type={type === "submit" || type === "reset" ? type : "button"}
      class:list={[
        "btn",
        `btn--${variant}`,
        `btn--${size}`,
        iconOnly && "btn--icon-only",
        className,
      ]}
      {...rest}
    >
      {iconLeft && (
        <svg
          class="btn__icon arrow-animated btn__icon--left"
          class:list={[iconLeft === "arrow-left" && "arrow-animated--left"]}
          viewBox="0 0 24 24"
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="5" y1="12" x2="19" y2="12" class="arrow-animated__line" />
          <polyline
            points={
              iconLeft === "arrow-left" ? "12 5 5 12 12 19" : "12 5 19 12 12 19"
            }
            class="arrow-animated__poly"
          />
        </svg>
      )}
      {showText ? (
        <span class="btn__content">
          <slot />
        </span>
      ) : showSlotAsIcon ? (
        <span class="btn__content">
          <slot />
        </span>
      ) : null}
      {iconRight && (
        <svg
          class="btn__icon arrow-animated btn__icon--right"
          class:list={[iconRight === "arrow-left" && "arrow-animated--left"]}
          viewBox="0 0 24 24"
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="5" y1="12" x2="19" y2="12" class="arrow-animated__line" />
          <polyline
            points={
              iconRight === "arrow-left"
                ? "12 5 5 12 12 19"
                : "12 5 19 12 12 19"
            }
            class="arrow-animated__poly"
          />
        </svg>
      )}
    </button>
  )
}

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    text-decoration: none;
    border: 1px solid currentColor;
    background: transparent;
    color: inherit;
    cursor: pointer;
    white-space: nowrap;
  }

  .btn--sm {
    padding: 0.25rem 0.5rem;
    font-size: 0.875rem;
  }

  .btn--md {
    padding: 0.375rem 0.75rem;
  }

  .btn--lg {
    padding: 0.5rem 0.875rem;
  }

  .btn--primary {
    font-weight: 600;
  }

  .btn--ghost {
    background: transparent;
  }

  .btn--outline {
    background: transparent;
  }

  .btn__icon {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
  }

  .btn--icon-only {
    min-width: 2.25rem;
    min-height: 2.25rem;
    padding: 0.375rem;
  }

  .btn__icon--left {
    margin-right: -0.125rem;
  }

  .btn__icon--right {
    margin-left: -0.125rem;
  }

  .btn__content {
    display: inline-flex;
    align-items: center;
  }
</style>
