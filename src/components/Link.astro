---
type Props = {
  href: string;
  external?: boolean;
  underline?: boolean;
  class?: string;
};

const { href, external, underline = true, class: className, ...rest } = Astro.props;
---

<a
  href={href}
  target={external ? "_blank" : "_self"}
  rel={external ? "noopener noreferrer" : undefined}
  class:list={["link", underline && "link--underline", className]}
  {...rest}
>
  <slot />
</a>

<style>
  .link {
    color: currentColor;
  }

  .link--underline {
    text-decoration: underline;
  }
</style>
