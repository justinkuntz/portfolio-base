---
import { getCollection } from "astro:content";
import Container from "@components/Container.astro";
import ArrowCard from "@components/ArrowCard";
import Button from "@components/Button.astro";
import ThemeToggle from "@components/ThemeToggle.astro";
import PageLayout from "@layouts/PageLayout.astro";

const blogSample = (await getCollection("blog"))
  .filter((entry) => !entry.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())[0];

const projectSample = (await getCollection("projects"))
  .filter((entry) => !entry.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())[0];
---

<PageLayout
  title="Styleguide"
  description="Reference page for the stripped baseline."
  seo={{ kind: "page", noindex: true }}
>
  <Container size="xl">
    <article>
      <h1>Styleguide</h1>
      <p>
        This route is now a plain reference page for the stripped baseline.
        Most decorative layout styling has been removed so the page reads in
        normal document flow.
      </p>

      <section>
        <h2>Color mode</h2>
        <p>Use the toggle below to inspect the site in light and dark mode.</p>
        <p><ThemeToggle id="styleguide-theme-toggle" size="md" /></p>
      </section>

      <section>
        <h2>Controls</h2>
        <p>
          <Button>Button</Button>
          {" "}
          <Button iconRight="arrow">Button with arrow</Button>
        </p>
        <form>
          <p>
            <label>
              Name
              <br />
              <input type="text" placeholder="Jane Founder" />
            </label>
          </p>
          <p>
            <label>
              Email
              <br />
              <input type="email" placeholder="jane@example.com" />
            </label>
          </p>
          <p>
            <label>
              Notes
              <br />
              <textarea rows="6" placeholder="Warm neutrals, stronger contrast…" />
            </label>
          </p>
        </form>
      </section>

      <section>
        <h2>Content</h2>
        <blockquote>
          Strong foundations make future styling changes less risky.
        </blockquote>
        <pre><code>{`article pre {
  overflow-x: auto;
}`}</code></pre>
      </section>

      <section>
        <h2>Cards</h2>
        <div>
          {projectSample && <ArrowCard entry={projectSample} />}
          {blogSample && <ArrowCard entry={blogSample} />}
        </div>
      </section>
    </article>
  </Container>
</PageLayout>
