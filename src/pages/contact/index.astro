---
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import Button from "@components/Button.astro";
import { CONTACT } from "@consts";

const searchParams = Astro.url.searchParams;
const statusParam = searchParams.get("status");
const reasonParam = searchParams.get("reason");

const statusCopy = (() => {
  if (statusParam === "success") {
    return {
      text: "Transmission received. Grogu will review it between training sessions.",
    };
  }
  if (statusParam === "error") {
    const text =
      reasonParam === "rate-limit"
        ? "You're sending messages a bit too quickly. Please wait a moment and try again."
        : "We couldn't send your message. Please try again in a moment.";
    return { text };
  }
  return null;
})();
---

<PageLayout
  title={CONTACT.TITLE}
  description={CONTACT.DESCRIPTION}
  seo={{ kind: "page", generatedImage: true }}
>
  <Container size="lg">
    <section>
      <div>
        <div>
          <p>{CONTACT.TITLE}</p>
          <h1>Send a transmission to the covert</h1>
          <p>
            Have a mission, a collaboration, or a discreet request that needs a
            steady hand? Send the details and Grogu will respond when the ship
            is back in range.
          </p>
          <ul>
            <li>
              <span>Availability</span>
              <span>Accepting new missions this season.</span>
            </li>
            <li>
              <span>Response time</span>
              <span>Usually within 48 hours, unless hyperspace gets noisy.</span>
            </li>
          </ul>
        </div>
        <div>
          {
            statusCopy && (
              <p>{statusCopy.text}</p>
            )
          }
          <form
            id="contact-form"
            action="/api/contact"
            method="post"
            novalidate
          >
            <input type="hidden" name="startedAt" id="contact-started" />
            <label class="sr-only" for="contact-company">Company</label>
            <input
              id="contact-company"
              name="company"
              type="text"
              tabindex="-1"
              autocomplete="off"
              aria-hidden="true"
              style="position:absolute;left:-9999px;opacity:0;"
            />

            <p>
              <label for="contact-name">Name</label>
              <input
                id="contact-name"
                name="name"
                type="text"
                required
                minlength="2"
                autocomplete="name"
                placeholder="Din Djarin"
              />
            </p>

            <p>
              <label for="contact-email">Email</label>
              <input
                id="contact-email"
                name="email"
                type="email"
                required
                autocomplete="email"
                placeholder="din@covert.space"
              />
            </p>

            <p>
              <label for="contact-message">Message</label>
              <br />
              <span id="contact-message-hint">Minimum 20 characters</span>
              <br />
              <textarea
                id="contact-message"
                name="message"
                required
                minlength="20"
                rows="6"
                aria-describedby="contact-message-hint"
                placeholder="Share the mission, timeline, constraints, and anything Grogu should know before boarding."
              ></textarea>
            </p>

            <div>
              <p>
                By submitting you agree to receive a reply at the email address
                you provided.
              </p>
              <Button type="submit">
                <span data-submit-text>Send transmission</span>
              </Button>
              <p
                id="contact-status"
                role="status"
                aria-live="polite"
                hidden
              >
              </p>
            </div>
          </form>
        </div>
      </div>
    </section>
  </Container>
</PageLayout>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const status = document.getElementById("contact-status");
  const submitButton = form?.querySelector("button[type=submit]") as HTMLButtonElement | null | undefined;
  const startedAtInput = document.getElementById("contact-started") as HTMLInputElement | null;

  function setTimestamp() {
    if (startedAtInput) {
      startedAtInput.value = Date.now().toString();
    }
  }

  function setStatus(message: string) {
    if (!status) return;
    status.textContent = message;
    status.hidden = false;
  }

  function clearStatus() {
    if (!status) return;
    status.textContent = "";
    status.hidden = true;
  }

  async function handleSubmit(event: Event) {
    event.preventDefault();
    if (!form || !submitButton) return;

    clearStatus();

    const formData = new FormData(form);
    const message = (formData.get("message") || "").toString().trim();

    if (message.length < 20) {
      setStatus("Please include at least 20 characters so I have context.");
      return;
    }

    submitButton.disabled = true;

    formData.set("startedAt", startedAtInput?.value || Date.now().toString());

    try {
      const response = await fetch(form.action, {
        method: "POST",
        headers: {
          "X-Requested-With": "contact-form",
        },
        body: formData,
      });

      const payload = await response.json().catch(() => null);

      if (!response.ok) {
        throw new Error(
          payload?.message ||
            "We couldn't send your message. Please try again.",
        );
      }

      form.reset();
      setTimestamp();
      setStatus(payload?.message || "Thanks for reaching out!");
    } catch (error) {
      const fallback =
        "We couldn't send your message. Please try again in a moment.";
      setStatus(error instanceof Error ? error.message : fallback);
    } finally {
      submitButton.disabled = false;
    }
  }

  function init() {
    setTimestamp();
    form?.addEventListener("submit", handleSubmit);
  }

  init();
  document.addEventListener("astro:after-swap", () => {
    clearStatus();
    setTimestamp();
  });
</script>
